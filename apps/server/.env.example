# Copy to apps/server/.env and fill in. .env is gitignored; this file is not.

# MongoDB Atlas (or any MongoDB 5.0+). Full connection string, credentials included.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database to use inside the cluster (the URI above doesn't name one).
MONGODB_DB_NAME=secure_notes

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

PORT=3000
# Origin(s) of the deployed frontend, comma-separated. No trailing slash.
CORS_ORIGIN=http://localhost:4200

# Number of proxies in front of the API (1 on most hosts), so the rate limit sees each
# client's real IP. false when running directly. Avoid "true": it trusts any X-Forwarded-For.
TRUST_PROXY=false
# Register/login attempts per minute, per client IP, per route.
AUTH_RATE_LIMIT=5

# Serve the API reference at /api/docs (Scalar UI) and /api/docs/openapi.json.
API_DOCS=true
