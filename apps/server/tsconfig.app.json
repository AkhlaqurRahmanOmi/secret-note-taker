{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    // The base config emits declarations only (for typecheck's `tsc --build`, which passes
    // the flag itself). webpack's ts-loader needs real JS output once the Swagger plugin is
    // a transformer, because transformers need a full program instead of transpile-only.
    "emitDeclarationOnly": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["eslint.config.js", "eslint.config.cjs", "eslint.config.mjs"]
}
